{
  "name": "balatro-mod-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Balatro's mod editor: make content mods (jokers, consumables, vouchers, decks, boss blinds, rules, art) for BalatroEngine, test them in the real engine and publish them",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "steiger src",
    "test": "node --test scripts/tests/*.test.ts",
    "parity": "node scripts/parity/run.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "steiger": "^0.8.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
